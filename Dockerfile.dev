# Dev image for the Next.js web service. Source is bind-mounted by compose, so
# this stays intentionally thin; `npm install` runs at container start.
FROM node:22-alpine

WORKDIR /app

# Copy manifests first for a warm layer; the bind mount overlays the rest.
COPY package.json package-lock.json* ./

EXPOSE 3000

CMD ["npm", "run", "dev"]
